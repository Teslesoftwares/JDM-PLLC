# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/menstrocare?schema=public"

# Authentication
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# SMS
# SMS_PROVIDER="http" enables the generic bearer-auth gateway below; unset logs messages only.
SMS_PROVIDER=""
SMS_API_URL=""
SMS_API_KEY=""
SMS_FROM=""

# WhatsApp
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# File Storage
# STORAGE_PROVIDER="s3" to use S3-compatible storage; leave unset for the local disk store.
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""
# Signing secret for local document download URLs; falls back to AUTH_SECRET.
DOCUMENT_SIGNING_SECRET=""

# Payment - MTN MoMo
MTN_MOMO_API_URL=""
MTN_MOMO_API_KEY=""
MTN_MOMO_API_SECRET=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_ENVIRONMENT="sandbox"

# Payment - Telecel
TELECEL_API_URL=""
TELECEL_API_KEY=""

# Payment - AirtelTigo
AIRTELTIGO_API_URL=""
AIRTELTIGO_API_KEY=""

# Payment - Card
CARD_API_URL=""
CARD_API_KEY=""

# Redis
REDIS_URL=""

# Application
# APP_NAME overrides the name used in emails and documents; leave it unset
# to use the name in src/config/site.ts.
# APP_NAME="JDM Presidential Library & Legacy Centre"
APP_URL="http://localhost:3000"
APP_ENV="development"

# Public site / SEO
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SITEMAP_URL="http://localhost:3000/sitemap.xml"
ROBOTS_URL="http://localhost:3000/robots.txt"

# Centre identity
# CENTRE_WEBSITE and CENTRE_EMAIL override the placeholders in src/config/site.ts.
# Replace both with verified details before launch.
# CENTRE_WEBSITE="https://jdmpll.example"
# CENTRE_EMAIL="no-reply@jdmpll.example"

# Social profiles. Leave unset until the Centre confirms the real URLs — the
# footer only renders icons for networks that have a value here.
# CENTRE_FACEBOOK="https://www.facebook.com/..."
# CENTRE_INSTAGRAM="https://www.instagram.com/..."
# CENTRE_X="https://x.com/..."
# CENTRE_LINKEDIN="https://www.linkedin.com/company/..."
